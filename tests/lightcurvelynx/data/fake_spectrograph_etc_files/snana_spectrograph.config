# Description of input config file used for command
#    make_spectrograph_table.py <config_file>

INSTRUMENT:       Gemini 
WAVE_R:         1522
WAVE_UNIT:        nm
WAVE_BIN_SIZE:    20
OUTFILE_SNANA:    gemini_band1_spectrograph.dat
OUTFILE_TABLE:    gemini_band1_spectrograph_plot_table.dat

# The example below has separate blue and red spectra that are
# combined into a single SNR map in the output SPECTROGRAPH file,
# which results in a single blue+red spectrum from the simulation. 
# Beware that the Texpose range below must cover Texpose requests
# in the TEXPOSE argument of sim-input TAKE_SPECTRUM keys.

SEDFLUX_TABLES:   
#   magref Texpose   spec_table_file
  -   19     500    merged_mag19_500nm_t500.dat     # table contents: wave flux fluxerr
  -   19     500    merged_mag19_700nm_t500.dat
  -   22     500    merged_mag22_500nm_t500.dat
  -   22     500    merged_mag22_700nm_t500.dat
#
  -   19    1200    merged_mag19_500nm_t1200.dat
  -   19    1200    merged_mag19_700nm_t1200.dat
  -   22    1200    merged_mag22_500nm_t1200.dat
  -   22    1200    merged_mag22_700nm_t1200.dat
#
  -   19    4000    merged_mag19_500nm_t4000.dat
  -   19    4000    merged_mag19_700nm_t4000.dat
  -   22    4000    merged_mag22_500nm_t4000.dat
  -   22    4000    merged_mag22_700nm_t4000.dat

